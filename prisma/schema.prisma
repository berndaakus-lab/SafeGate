generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model School {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  logoUrl   String?
  createdAt DateTime @default(now())

  students Student[]
  staff    Staff[]
  parents  Parent[]
}

model Staff {
  id       String    @id @default(cuid())
  name     String
  email    String    @unique
  password String
  role     StaffRole @default(ADMIN)
  schoolId String
  school   School    @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())
}

model Parent {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String
  phone    String?
  photoUrl String?
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())

  children         Student[]
  authorizedPeople AuthorizedPerson[]
  pickupCodes      PickupCode[]
}

model Student {
  id        String  @id @default(cuid())
  name      String
  photoUrl  String?
  className String?
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id])
  parentId  String
  parent    Parent  @relation(fields: [parentId], references: [id])
  createdAt DateTime @default(now())

  pickupCodes PickupCode[]
  pickupLogs  PickupLog[]
}

model AuthorizedPerson {
  id       String  @id @default(cuid())
  name     String
  phone    String?
  photoUrl String?
  relation String?
  parentId String
  parent   Parent  @relation(fields: [parentId], references: [id])

  pickupCodes PickupCode[]
  pickupLogs  PickupLog[]
}

model PickupCode {
  id                 String           @id @default(cuid())
  code               String           @unique @default(cuid())
  studentId          String
  student            Student          @relation(fields: [studentId], references: [id])
  parentId           String
  parent             Parent           @relation(fields: [parentId], references: [id])
  authorizedPersonId String
  authorizedPerson   AuthorizedPerson @relation(fields: [authorizedPersonId], references: [id])
  expiresAt          DateTime
  usedAt             DateTime?
  createdAt          DateTime         @default(now())

  pickupLog PickupLog?
}

model PickupLog {
  id                 String           @id @default(cuid())
  studentId          String
  student            Student          @relation(fields: [studentId], references: [id])
  authorizedPersonId String
  authorizedPerson   AuthorizedPerson @relation(fields: [authorizedPersonId], references: [id])
  pickupCodeId       String           @unique
  pickupCode         PickupCode       @relation(fields: [pickupCodeId], references: [id])
  pickedUpAt         DateTime         @default(now())
  guardName          String?
  notes              String?
}

enum StaffRole {
  ADMIN
  GUARD
  TEACHER
}
